include ./hl.conf
# You can add your own configuration options for kitty below. They will not be overwritten.

# Fonts
font_family              Hack Nerd Font
bold_font                auto
italic_font              auto
bold_italic_font         auto
font_size                10
adjust_line_height       110%
disable_ligatures        never

# Rendering / “animation feel”
# (Lower repaint_delay + vsync makes cursor & resize feel smoother)
repaint_delay            7
input_delay              0
sync_to_monitor          yes       # (aka vsync)
cursor_blink_interval    0.5
cursor_stop_blinking_after 0
cursor_shape             beam

cursor_trail 2
cursor_trail_decay 0.2 0.2

# Shell integration (makes kitten goodies nicer)
shell_integration        enabled

# Visual bell = quick flash instead of beep
enable_audio_bell        no
visual_bell_duration     0.08
visual_bell_color        #e0af68

# Scrollback & mouse
scrollback_lines         20000
scrollback_pager         less --RAW-CONTROL-CHARS +G
wheel_scroll_multiplier  2.0
mouse_hide_wait          2.0
copy_on_select           yes

confirm_os_window_close 0

window_padding_width 5
